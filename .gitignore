# Dependências do Composer (instalar com: composer install)
/vendor/

# Configurações com senha — ficam só no servidor
/includes/config.local.php
/php/config.json

# Dados e arquivos gerados em produção (documentos digitalizados, anexos, backups)
/uploads/*
!/uploads/.htaccess
/backup_temp/*
!/backup_temp/.htaccess
/paginas/*
/documentos/*
/thumbs/*
