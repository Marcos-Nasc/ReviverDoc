# Dados internos do Arquivo (lista de livros) — fica só no servidor
/planilha_arquivo.xlsx

# Logs, dumps e pacotes
*.log
*.sql
!/db/*.sql
*.zip
*.rar
*.7z
*.tar
*.gz
*.pdf

node_modules/
allfiles.txt
